# Local development example only; copy to .env and choose your own password.
POSTGRES_PASSWORD=employee_dev_password
POSTGRES_PORT=5433
# The Go application reads environment variables, not this file automatically.
DATABASE_URL=postgres://employee_app:employee_dev_password@127.0.0.1:5433/employee_api?sslmode=disable
HTTP_ADDR=127.0.0.1:8080
DB_MAX_CONNECTIONS=10
DB_CONNECT_TIMEOUT=5s
DB_QUERY_TIMEOUT=3s
